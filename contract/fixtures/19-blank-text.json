{
  "name": "19-blank-text",
  "description": "One text rule: a value is blank when it is not a string, is empty, or has only Unicode White_Space or the zero-width characters U+200B, U+200C, U+200D, U+2060, U+FEFF. Whitespace-only and zero-width-only names (NBSP, U+200B, U+FEFF, U+3000, a mix) are 400 on signup and on account update; blank address and token text is 400 on order save, shipping and pay; a normal name still works.",
  "demo": false,
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "\u00a0",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "name, email, phone, and password are required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "\u200b",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "name, email, phone, and password are required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "\ufeff",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "name, email, phone, and password are required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "\u3000",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "name, email, phone, and password are required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "\u00a0\u200d\u2060 \u3000",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "name, email, phone, and password are required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": 123,
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "name, email, phone, and password are required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "Fixture Shopper",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 201,
        "schema": "UserPublic@user"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account",
        "body": {
          "name": "\u00a0"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Enter a name (text, at most 200 characters)"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account",
        "body": {
          "name": "\u200b"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Enter a name (text, at most 200 characters)"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account",
        "body": {
          "name": "\ufeff"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Enter a name (text, at most 200 characters)"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account",
        "body": {
          "name": "\u3000"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Enter a name (text, at most 200 characters)"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account",
        "body": {
          "name": "\u00a0\u200d\u2060 \u3000"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Enter a name (text, at most 200 characters)"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account",
        "body": {
          "name": [
            "x"
          ]
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Enter a name (text, at most 200 characters)"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account",
        "body": {
          "name": "Renamed Shopper"
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "user": {
            "name": "Renamed Shopper"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/cart/items",
        "body": {
          "productId": "p1",
          "qty": 1
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "body": {
          "shippingAddress": {
            "name": "\u200b",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          },
          "billingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          }
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Shipping and billing addresses need name, address1, city, region, country, and zipcode (non-empty text, at most 200 characters each)"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "body": {
          "shippingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          },
          "billingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "\u3000"
          }
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Shipping and billing addresses need name, address1, city, region, country, and zipcode (non-empty text, at most 200 characters each)"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "body": {
          "shippingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          },
          "billingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          }
        }
      },
      "expect": {
        "status": 201
      },
      "save": {
        "orderId": "order.id"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/orders/{{orderId}}/shipping",
        "body": {
          "shippingAddress": {
            "name": "\ufeff",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          }
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "shippingAddress is incomplete: every field must be non-empty text of at most 200 characters"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders/{{orderId}}/pay",
        "body": {
          "payment": {
            "token": "\u00a0",
            "cardBin": "411111",
            "cardLast4": "1111"
          }
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Payment needs token (non-empty text, at most 200 characters), cardBin (6 or 8 digits), and cardLast4 (4 digits)"
        }
      }
    }
  ]
}
