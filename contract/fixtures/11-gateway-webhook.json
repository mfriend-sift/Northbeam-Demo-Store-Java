{
  "name": "11-gateway-webhook",
  "description": "A dispute webhook marks the order chargeback; an unknown charge is 404; other types are acknowledged.",
  "demo": false,
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "Fixture Shopper",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 201,
        "schema": "UserPublic@user",
        "match": {
          "user": {
            "name": "Fixture Shopper",
            "email": "fixture+{{runId}}@example.com",
            "phone": "+14155550199"
          }
        }
      },
      "save": {
        "userId": "user.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/cart/items",
        "body": {
          "productId": "p1",
          "qty": 1
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "cart": [
            {
              "productId": "p1",
              "qty": 1
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "body": {
          "shippingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          },
          "billingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          }
        }
      },
      "expect": {
        "status": 201,
        "schema": "Order@order",
        "match": {
          "order": {
            "id": "<string>",
            "status": "saved"
          }
        }
      },
      "save": {
        "orderId": "order.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders/{{orderId}}/pay",
        "body": {
          "payment": {
            "token": "tok_visa",
            "cardBin": "411111",
            "cardLast4": "1111"
          }
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "order": {
            "status": "paid"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/orders"
      },
      "expect": {
        "status": 200
      },
      "save": {
        "chargeId": "orders.0.chargeId"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/webhooks/gateway",
        "body": {
          "type": "charge.dispute.created",
          "data": {
            "chargeId": "{{chargeId}}",
            "reason": "duplicate",
            "status": "needs_response"
          }
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "received": true
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/orders"
      },
      "expect": {
        "status": 200,
        "match": {
          "orders": [
            {
              "id": "{{orderId}}",
              "status": "chargeback",
              "chargeback": {
                "reason": "duplicate",
                "status": "needs_response"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/webhooks/gateway",
        "body": {
          "type": "charge.dispute.created",
          "data": {
            "chargeId": "ch_00000",
            "reason": "duplicate",
            "status": "needs_response"
          }
        }
      },
      "expect": {
        "status": 404,
        "schema": "Error"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/webhooks/gateway",
        "body": {
          "type": "charge.succeeded",
          "data": {
            "chargeId": "{{chargeId}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "received": true
        }
      }
    }
  ]
}
