{
  "name": "10-shipping-update",
  "description": "PUT /api/orders/:id/shipping changes address and method before and after payment; bad input is 400; other users' orders are 404.",
  "demo": false,
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "Fixture Shopper",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 201,
        "schema": "UserPublic@user",
        "match": {
          "user": {
            "name": "Fixture Shopper",
            "email": "fixture+{{runId}}@example.com",
            "phone": "+14155550199"
          }
        }
      },
      "save": {
        "userId": "user.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/cart/items",
        "body": {
          "productId": "p1",
          "qty": 1
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "cart": [
            {
              "productId": "p1",
              "qty": 1
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "body": {
          "shippingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          },
          "billingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          }
        }
      },
      "expect": {
        "status": 201,
        "schema": "Order@order",
        "match": {
          "order": {
            "id": "<string>",
            "status": "saved"
          }
        }
      },
      "save": {
        "orderId": "order.id"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/orders/{{orderId}}/shipping",
        "body": {
          "shippingAddress": {
            "name": "Fixture Shopper",
            "address1": "1 Ferry Building",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94111"
          },
          "shippingMethod": "expedited"
        }
      },
      "expect": {
        "status": 200,
        "schema": "Order@order",
        "match": {
          "order": {
            "id": "{{orderId}}",
            "status": "saved",
            "shippingMethod": "expedited",
            "shippingAddress": {
              "zipcode": "94111"
            },
            "billingAddress": {
              "zipcode": "94105"
            },
            "total": 89,
            "items": [
              {
                "productId": "p1",
                "qty": 1
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/orders/{{orderId}}/shipping",
        "body": {
          "shippingMethod": "overnight"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/orders/{{orderId}}/shipping",
        "body": {}
      },
      "expect": {
        "status": 400,
        "schema": "Error"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders/{{orderId}}/pay",
        "body": {
          "payment": {
            "token": "tok_visa",
            "cardBin": "411111",
            "cardLast4": "1111"
          }
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "order": {
            "status": "paid",
            "shippingAddress": {
              "zipcode": "94111"
            },
            "shippingMethod": "expedited"
          }
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/orders/{{orderId}}/shipping",
        "body": {
          "shippingAddress": {
            "name": "Fixture Shopper",
            "address1": "100 Market St",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94105"
          }
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "order": {
            "status": "paid",
            "shippingAddress": {
              "zipcode": "94105"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/orders/ORD-20001/shipping",
        "body": {
          "shippingAddress": {
            "name": "Fixture Shopper",
            "address1": "1 Ferry Building",
            "city": "San Francisco",
            "region": "CA",
            "country": "US",
            "zipcode": "94111"
          }
        }
      },
      "expect": {
        "status": 404,
        "schema": "Error"
      }
    }
  ]
}
