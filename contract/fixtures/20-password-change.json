{
  "name": "20-password-change",
  "description": "Password change (PUT /api/account/password): no session is 401; a weak (empty or missing) new password is 400; a wrong current password is 400 with 'Current password is incorrect' and no notice is sent; a correct change is 200 {ok:true}, the old password no longer logs in, the new one does, and exactly one security notice (password_changed, email) shows in notices on GET /api/account. The notice list is read per user, so it also runs without DEMO=1.",
  "demo": false,
  "steps": [
    {
      "request": {
        "method": "PUT",
        "path": "/api/account/password",
        "body": {
          "currentPassword": "Demo!2026",
          "newPassword": "Next!2026"
        }
      },
      "expect": {
        "status": 401,
        "schema": "Error"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "Fixture Shopper",
          "email": "fixture+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 201,
        "schema": "UserPublic@user"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account/password",
        "body": {
          "currentPassword": "Demo!2026",
          "newPassword": ""
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account/password",
        "body": {
          "currentPassword": "Demo!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account/password",
        "body": {
          "currentPassword": "Wrong!2026",
          "newPassword": "Next!2026"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Error",
        "match": {
          "error": "Current password is incorrect"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/account"
      },
      "expect": {
        "status": 200,
        "match": {
          "notices": []
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/account/password",
        "body": {
          "currentPassword": "Demo!2026",
          "newPassword": "Next!2026"
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "ok": true
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/account"
      },
      "expect": {
        "status": 200,
        "schema": "Account@user",
        "match": {
          "notices": [
            {
              "to": "fixture+{{runId}}@example.com",
              "kind": "password_changed",
              "channel": "email",
              "at": "<string>"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/logout"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/login",
        "body": {
          "email": "fixture+{{runId}}@example.com",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 401,
        "schema": "Error"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/login",
        "body": {
          "email": "fixture+{{runId}}@example.com",
          "password": "Next!2026"
        }
      },
      "expect": {
        "status": 200,
        "schema": "UserPublic@user"
      }
    }
  ]
}
