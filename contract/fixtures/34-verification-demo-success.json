        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": "000000"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Attempts",
        "match": {
          "error": "That code is not correct",
          "attempts": 2,
          "attemptsLeft": 3
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": "000000"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Attempts",
        "match": {
          "error": "That code is not correct",
          "attempts": 3,
          "attemptsLeft": 2
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": "000000"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Attempts",
        "match": {
          "error": "That code is not correct",
          "attempts": 4,
          "attemptsLeft": 1
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": "000000"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Attempts",
        "match": {
          "error": "That code is not correct",
          "attempts": 5,
          "attemptsLeft": 0
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": "123456"
        }
      },
      "expect": {
        "status": 429,
        "schema": "Attempts",
        "match": {
          "error": "Too many wrong codes. Try again later",
          "attempts": 5,
          "attemptsLeft": 0,
          "retryAfterSeconds": "<number>"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/start",
        "body": {
          "channel": "email"
        }
      },
      "expect": {
        "status": 429,
        "schema": "Attempts",
        "match": {
          "error": "Too many wrong codes. Try again later",
          "retryAfterSeconds": "<number>"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/start",
        "headers": {
          "X-Demo-Now": "4102445760000"
        },
        "body": {
          "channel": "email"
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "status": "pending"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "headers": {
          "X-Demo-Now": "4102445760000"
        },
        "body": {
          "code": "123456"
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "status": "success",
          "verified": true
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/demo/reset",
        "body": {}
      },
      "expect": {
