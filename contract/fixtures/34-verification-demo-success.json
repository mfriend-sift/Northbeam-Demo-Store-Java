{
  "name": "34-verification-demo-success",
  "description": "Verification with the demo code (DEMO=1: the code is the fixed 123456 and the notice shows it). start sms: the notice lists kind verification_code, channel sms, the phone and code 123456; a wrong code is 400 attempts 1; the right code is 200 { status: success, verified: true }; GET /api/account then has verified: true; start and confirm after that are 409 (already verified, no verification in progress); verified survives logout and login. The code is accepted with spaces around it (' 123456 '). After 5 wrong codes even 123456 is 429 and starting a new code is 429 too (the lockout is not cleared by a restart); 16 minutes later (X-Demo-Now) a new code can be started and 123456 is accepted. /demo/reset clears a verification in progress: a code started before the reset cannot be confirmed by the next account.",
  "demo": true,
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "Fixture Shopper",
          "email": "ver2+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 201,
        "schema": "UserPublic@user"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/start",
        "body": {
          "channel": "sms"
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "status": "pending",
          "channel": "sms",
          "code": "<absent>"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/account"
      },
      "expect": {
        "status": 200,
        "schema": "Account@user",
        "match": {
          "user": {
            "verified": false
          },
          "notices": [
            {
              "kind": "verification_code",
              "channel": "sms",
              "to": "+14155550199",
              "code": "123456"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": "000000"
        }
      },
      "expect": {
        "status": 400,
        "schema": "Attempts",
        "match": {
          "error": "That code is not correct",
          "attempts": 1,
          "attemptsLeft": 4
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": " 123456 "
        }
      },
      "expect": {
        "status": 200,
        "match": {
          "status": "success",
          "verified": true
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/account"
      },
      "expect": {
        "status": 200,
        "schema": "Account@user",
        "match": {
          "user": {
            "verified": true
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/start",
        "body": {
          "channel": "email"
        }
      },
      "expect": {
        "status": 409,
        "schema": "Error",
        "match": {
          "error": "Your account is already verified"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/verification/confirm",
        "body": {
          "code": "123456"
        }
      },
      "expect": {
        "status": 409,
        "schema": "Error",
        "match": {
          "error": "No verification is in progress"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/logout",
        "body": {}
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/login",
        "body": {
          "email": "ver2+{{runId}}@example.com",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/account"
      },
      "expect": {
        "status": 200,
        "schema": "Account@user",
        "match": {
          "user": {
            "verified": true
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/logout",
        "body": {}
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/signup",
        "body": {
          "name": "Fixture Shopper",
          "email": "ver3+{{runId}}@example.com",
          "phone": "415-555-0199",
          "password": "Demo!2026"
        }
      },
      "expect": {
        "status": 201,
        "schema": "UserPublic@user"
      }
    },
    {
      "request": {
